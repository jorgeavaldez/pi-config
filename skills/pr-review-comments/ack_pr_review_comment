#!/bin/bash
# vim: set filetype=bash:

set -euo pipefail

# Acknowledge a top-level PR review body by adding the configured reaction.
# These reviews are not resolvable threads, so get_pr_review_comments treats this
# reaction from the current gh user as "handled" and skips the review later.

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

ACK_REACTION_CONTENT="${PR_REVIEW_ACK_REACTION:-EYES}"

log_info() { echo -e "${GREEN}[INFO]${NC} $1" >&2; }
log_warn() { echo -e "${YELLOW}[WARN]${NC} $1" >&2; }
log_error() { echo -e "${RED}[ERROR]${NC} $1" >&2; }

usage() {
    cat >&2 <<EOF
Usage: $(basename "$0") PRR_ID_OR_REVIEW_FEEDBACK_FILE

Adds a $ACK_REACTION_CONTENT reaction to a top-level PR review body (PRR_...).
You can pass either the review ID or the generated PRR_...-review-feedback.md file.

Set PR_REVIEW_ACK_REACTION to use a different GitHub reaction enum.
EOF
}

if [ $# -ne 1 ]; then
    usage
    exit 2
fi

input="$1"
if [ -f "$input" ]; then
    review_id=$(basename "$input")
    review_id="${review_id%-review-feedback.md}"
else
    review_id="$input"
fi

if [[ ! "$review_id" =~ ^PRR_ ]]; then
    log_error "Expected a top-level PR review ID starting with PRR_, got: $review_id"
    log_error "Inline PRRC_ comments should be resolved with resolve-pr-comment instead."
    exit 1
fi

log_info "Checking acknowledgement state for $review_id..."
reaction_state=$(gh api graphql \
    -f subjectId="$review_id" \
    -f query='
query($subjectId: ID!) {
  node(id: $subjectId) {
    ... on PullRequestReview {
      id
      reactionGroups {
        content
        viewerHasReacted
      }
    }
  }
}')

if [ "$(echo "$reaction_state" | jq -r '.data.node.id // empty')" != "$review_id" ]; then
    log_error "Could not find PullRequestReview node for ID: $review_id"
    exit 1
fi

already_reacted=$(echo "$reaction_state" | jq -r --arg ack_reaction "$ACK_REACTION_CONTENT" '
    [.data.node.reactionGroups[]? | select(.content == $ack_reaction and .viewerHasReacted == true)] | length > 0
')

if [ "$already_reacted" = "true" ]; then
    log_info "$review_id already has your $ACK_REACTION_CONTENT reaction"
    exit 0
fi

log_info "Adding $ACK_REACTION_CONTENT reaction to $review_id..."
gh api graphql \
    -f subjectId="$review_id" \
    -f content="$ACK_REACTION_CONTENT" \
    -f query='
mutation($subjectId: ID!, $content: ReactionContent!) {
  addReaction(input: {subjectId: $subjectId, content: $content}) {
    reaction { content }
  }
}' \
    --jq '.data.addReaction.reaction.content'

log_info "Acknowledged $review_id"
