#!/bin/bash
# vim: set filetype=bash:

set -euo pipefail

# Script to extract GitHub PR review comments and output them for further processing

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

# Reaction used as an acknowledgement for top-level PR review bodies. GitHub
# does not expose those as resolvable review threads, so acknowledged reviews are
# skipped on subsequent fetches.
ACK_REACTION_CONTENT="${PR_REVIEW_ACK_REACTION:-EYES}"

log_info() { echo -e "${GREEN}[INFO]${NC} $1" >&2; }
log_warn() { echo -e "${YELLOW}[WARN]${NC} $1" >&2; }
log_error() { echo -e "${RED}[ERROR]${NC} $1" >&2; }

# Detect if we're in a jj repo
IS_JJ=false
if jj root >/dev/null 2>&1; then
    IS_JJ=true
    log_info "Detected jj (Jujutsu) repository"
fi

# Function to extract GitHub owner and repo from git remote
get_github_repo_info() {
    log_info "Extracting repository info from git remote..."

    # Get the remote URL for origin
    local remote_url
    if ! remote_url=$(git remote get-url origin 2>/dev/null); then
        # Fallback: try jj git remote list (for non-colocated jj workspaces)
        if [ "$IS_JJ" = true ]; then
            remote_url=$(jj git remote list 2>/dev/null | awk '$1 == "origin" { print $2 }')
        fi
        if [ -z "$remote_url" ]; then
            log_error "Failed to get remote URL for 'origin'"
            log_error "Make sure you're in a git/jj repository with a remote named 'origin'"
            exit 1
        fi
    fi

    log_info "Remote URL: $remote_url"

    # Parse owner and repo from the URL
    # Handles formats:
    #   SSH: git@github.com:owner/repo.git
    #   HTTPS: https://github.com/owner/repo.git
    #   GHE: git@github.enterprise.com:owner/repo.git or https://github.enterprise.com/owner/repo.git
    local owner repo

    if [[ "$remote_url" =~ ^git@[^:]+:([^/]+)/(.+)\.git$ ]]; then
        # SSH format
        owner="${BASH_REMATCH[1]}"
        repo="${BASH_REMATCH[2]}"
    elif [[ "$remote_url" =~ ^https?://[^/]+/([^/]+)/(.+)\.git$ ]]; then
        # HTTPS format with .git
        owner="${BASH_REMATCH[1]}"
        repo="${BASH_REMATCH[2]}"
    elif [[ "$remote_url" =~ ^https?://[^/]+/([^/]+)/(.+)$ ]]; then
        # HTTPS format without .git
        owner="${BASH_REMATCH[1]}"
        repo="${BASH_REMATCH[2]}"
    else
        log_error "Could not parse owner/repo from remote URL: $remote_url"
        log_error "Expected format: git@host:owner/repo.git or https://host/owner/repo.git"
        exit 1
    fi

    if [ -z "$owner" ] || [ -z "$repo" ]; then
        log_error "Extracted empty owner or repo from remote URL"
        exit 1
    fi

    log_info "Detected repository: $owner/$repo"

    # Return as space-separated values
    echo "$owner $repo"
}

# Function to get the current bookmark/branch name
get_current_branch() {
    local branch=""

    if [ "$IS_JJ" = true ]; then
        # In jj: get bookmark from current revision, walk up if @ is empty
        branch=$(jj log -r @ --no-graph -T 'bookmarks' 2>/dev/null)
        if [ -z "$branch" ]; then
            branch=$(jj log -r @- --no-graph -T 'bookmarks' 2>/dev/null)
        fi
        if [ -z "$branch" ]; then
            branch=$(jj log -r @-- --no-graph -T 'bookmarks' 2>/dev/null)
        fi
        # jj may return multiple bookmarks or decorations — take the first one
        # Strip trailing markers like * (modified) and whitespace
        branch=$(echo "$branch" | head -1 | sed 's/[*[:space:]]*$//')
    else
        branch=$(git branch --show-current)
    fi

    echo "$branch"
}

# Function to check if current branch has a PR
# Args: $1 = owner/repo (for -R flag, needed in non-colocated jj workspaces)
get_current_pr() {
    local gh_repo_flag=()
    if [ -n "${1:-}" ]; then
        gh_repo_flag=(-R "$1")
    fi

    local current_branch
    current_branch=$(get_current_branch)

    if [ -z "$current_branch" ]; then
        log_error "Could not determine current branch/bookmark"
        if [ "$IS_JJ" = true ]; then
            log_error "No bookmark found on @, @-, or @--. Make sure a bookmark exists on your revision or its ancestors."
        fi
        exit 1
    fi

    log_info "Checking for PR on branch: $current_branch"

    local pr_info
    if ! pr_info=$(gh pr list "${gh_repo_flag[@]}" -s all --head "$current_branch" --json number --jq '.[0].number' 2>/dev/null); then
        log_error "Failed to query GitHub PR. Make sure 'gh' is authenticated."
        exit 1
    fi

    if [ -z "$pr_info" ] || [ "$pr_info" = "null" ]; then
        log_error "No PR found for current branch: $current_branch"
        log_error "Create a PR first or switch to a branch with an existing PR"
        exit 1
    fi

    echo "$pr_info"
}

# Function to check if a file path is stale (file doesn't exist)
is_comment_stale() {
    local file_path="$1"

    # If file_path is empty or null, consider it stale
    if [ -z "$file_path" ] || [ "$file_path" = "null" ]; then
        return 0 # stale
    fi

    # Check if file exists in the repository
    if [ ! -f "$file_path" ]; then
        log_warn "File does not exist: $file_path (marking as stale)"
        return 0 # stale
    fi

    return 1 # not stale
}

# Function to clean up comment body (remove bot boilerplate/footers)
clean_comment_body() {
    local body="$1"

    # Remove common bot footers/boilerplate and HTML elements.
    # Graphite adds everything from "*Spotted by [Diamond]" onwards.
    # Codex top-level PR review bodies add an explanatory <details> block.
    echo "$body" | sed -E '
        /<details([[:space:]>]|$)/,/<\/details>/d
        /\*Spotted by \[Diamond\]/,$d
        s/<[^>]*>//g
        /^[[:space:]]*$/d
    ' | sed -E '/^```suggestion$/,/^```$/d' | sed '/^[[:space:]]*$/d'
}

# Function to extract file path and line from a top-level PR review body.
# Some bots (for example Codex) leave review bodies rather than inline review
# thread comments. Those bodies include a GitHub blob URL such as:
# https://github.com/owner/repo/blob/sha/path/to/file.py#L12-L14
extract_review_body_location() {
    local body="$1"
    local repo_owner="$2"
    local repo_name="$3"
    local location_regex="https://[^[:space:]/]+/${repo_owner}/${repo_name}/blob/[^/[:space:]#]+/([^#[:space:]]+)#L([0-9]+)"

    if [[ "$body" =~ $location_regex ]]; then
        echo "${BASH_REMATCH[1]} ${BASH_REMATCH[2]}"
        return 0
    fi

    return 1
}

# Function to format comment output
format_comment() {
    local comment_id="$1"
    local file_path="$2"
    local line_number="$3"
    local clean_body="$4"
    local source="${5:-thread}"
    local review_url="${6:-}"

    # Format file path with line number if available
    local file_location="$file_path"
    if [ "$line_number" != "null" ] && [ -n "$line_number" ]; then
        file_location="$file_path:$line_number"
    fi

    echo "$file_location"
    echo ""
    if [ "$source" = "review" ]; then
        echo "Top-level PR review body (not a resolvable review thread): $review_url"
        echo "After addressing, acknowledge with: ~/.pi/agent/skills/pr-review-comments/ack_pr_review_comment $comment_id"
        echo ""
    fi
    echo "$clean_body"
}

# Main function
main() {
    log_info "Starting PR review comment extraction..."

    # Get repository info from git remote
    local repo_info repo_owner repo_name
    repo_info=$(get_github_repo_info)
    read -r repo_owner repo_name <<<"$repo_info"

    # Get current PR number
    local pr_number
    pr_number=$(get_current_pr "$repo_owner/$repo_name")
    log_info "Found PR #$pr_number"

    # Create temporary directory for processing
    local temp_dir
    temp_dir=$(mktemp -d)
    trap "rm -rf '$temp_dir'" EXIT

    # Fetch unresolved inline comments using GraphQL API.
    log_info "Fetching unresolved PR review thread comments..."
    local comments_json="$temp_dir/comments.json"
    local thread_comments_json="$temp_dir/thread-comments.json"
    local all_review_bodies_json="$temp_dir/all-review-bodies.json"
    local review_bodies_json="$temp_dir/review-bodies.json"

    if ! gh api graphql -f query='{ repository(owner: "'"$repo_owner"'", name: "'"$repo_name"'") { pullRequest(number: '$pr_number') { reviewThreads(first: 100) { edges { node { id isResolved comments(first: 10) { edges { node { id body path line author { login } createdAt } } } } } } } } }' \
        --jq '.data.repository.pullRequest.reviewThreads.edges[] | select(.node.isResolved == false) | .node.comments.edges[0].node | {id: .id, body: .body, path: .path, line: .line, created_at: .createdAt, source: "thread", url: null}' \
        >"$thread_comments_json"; then
        log_error "Failed to fetch PR review thread comments"
        exit 1
    fi

    # Fetch top-level PR review bodies. These are not review threads and cannot
    # be resolved, but some bots leave actionable feedback in this shape. Skip
    # reviews acknowledged by the current gh user with ACK_REACTION_CONTENT.
    log_info "Fetching top-level PR review bodies..."
    if ! gh api graphql -f query='{ repository(owner: "'"$repo_owner"'", name: "'"$repo_name"'") { pullRequest(number: '$pr_number') { reviews(first: 100) { edges { node { id body submittedAt url reactionGroups { content viewerHasReacted } } } } } } }' \
        | jq -c '.data.repository.pullRequest.reviews.edges[].node | select(((.body // "") | gsub("[[:space:]]"; "") | length) > 0)' \
        >"$all_review_bodies_json"; then
        log_error "Failed to fetch PR review bodies"
        exit 1
    fi

    if ! jq -c --arg ack_reaction "$ACK_REACTION_CONTENT" '
        select(([.reactionGroups[]? | select(.content == $ack_reaction and .viewerHasReacted == true)] | length) == 0)
        | {id: .id, body: .body, path: null, line: null, created_at: .submittedAt, source: "review", url: .url}
    ' "$all_review_bodies_json" >"$review_bodies_json"; then
        log_error "Failed to filter acknowledged PR review bodies"
        exit 1
    fi

    cat "$thread_comments_json" "$review_bodies_json" >"$comments_json"

    # Check if we got any comments
    if [ ! -s "$comments_json" ]; then
        log_warn "No unresolved comments or top-level review bodies found on PR #$pr_number"
        exit 0
    fi

    local total_comments thread_comment_count all_review_body_count review_body_count acknowledged_review_body_count
    total_comments=$(wc -l <"$comments_json")
    thread_comment_count=$(wc -l <"$thread_comments_json")
    all_review_body_count=$(wc -l <"$all_review_bodies_json")
    review_body_count=$(wc -l <"$review_bodies_json")
    acknowledged_review_body_count=$((all_review_body_count - review_body_count))
    log_info "Found $thread_comment_count unresolved thread comments and $review_body_count unacknowledged top-level review bodies"
    log_info "Acknowledged top-level review bodies skipped ($ACK_REACTION_CONTENT): $acknowledged_review_body_count"

    local processed_count=0
    local stale_count=0
    local review_without_location_count=0

    # Process each comment
    while IFS= read -r comment_json; do
        local comment_id file_path body line created_at source review_url

        comment_id=$(echo "$comment_json" | jq -r '.id')
        file_path=$(echo "$comment_json" | jq -r '.path')
        body=$(echo "$comment_json" | jq -r '.body')
        line=$(echo "$comment_json" | jq -r '.line')
        created_at=$(echo "$comment_json" | jq -r '.created_at')
        source=$(echo "$comment_json" | jq -r '.source // "thread"')
        review_url=$(echo "$comment_json" | jq -r '.url // ""')

        if [ "$source" = "review" ]; then
            local review_location
            if ! review_location=$(extract_review_body_location "$body" "$repo_owner" "$repo_name"); then
                log_info "Skipping top-level review $comment_id without a code location"
                ((review_without_location_count += 1))
                continue
            fi
            read -r file_path line <<<"$review_location"
        fi

        log_info "Processing $source comment $comment_id for file: $file_path"

        # Check if comment is stale
        if is_comment_stale "$file_path"; then
            log_warn "Skipping stale comment $comment_id (file: $file_path)"
            ((stale_count += 1))
            continue
        fi

        # Clean up comment body
        local clean_body
        clean_body=$(clean_comment_body "$body")

        # Format the prompt
        local formatted_prompt
        formatted_prompt=$(format_comment "$comment_id" "$file_path" "$line" "$clean_body" "$source" "$review_url")

        # Write to file
        local output_file="${comment_id}-review-feedback.md"
        echo "$formatted_prompt" >"$output_file"

        # Output the file location (this is what gets piped)
        echo "$output_file"

        ((processed_count += 1))
        log_info "Created: $output_file"

    done <"$comments_json"

    log_info "Processing complete!"
    log_info "Total comments/reviews considered: $total_comments"
    log_info "Top-level reviews without code location skipped: $review_without_location_count"
    log_info "Stale comments skipped: $stale_count"
    log_info "Files created: $processed_count"
}

# Run main function
main "$@"
